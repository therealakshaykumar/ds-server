NODE_ENV=development
PORT=4100

# Neon connection string (use the pooled one for the running server)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# Comma separated list of web app origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Use "none" when web and api are on different sites in production (requires HTTPS)
COOKIE_SAMESITE=lax

# Secret for cron callers of POST /jobs/:name (x-job-secret header)
JOB_SECRET=change-me-too

# Optional email via Resend. Leave empty to use in-app notifications only.
RESEND_API_KEY=
EMAIL_FROM=Dance School <no-reply@example.com>

# Used by `npm run db:seed` to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
